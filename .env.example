# Copy this file to ".env" and fill in your own values.
# The .env file is ignored by git so your password never ends up on GitHub.

PORT=3000

# Option A - local MongoDB server (what MongoDB Compass connects to by default)
MONGODB_URI=mongodb://127.0.0.1:27017/Portfolio

# Option B - MongoDB Atlas (replace <username>, <password> and the cluster address)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/Portfolio?retryWrites=true&w=majority

# Any long random string - used to sign JWT tokens
JWT_SECRET=replace_with_a_long_random_string
